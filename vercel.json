{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/chat.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/sara",
      "destination": "/api/chat?mode=sara"
    },
    {
      "source": "/admin",
      "destination": "https://tcs-admin-panel.vercel.app/"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://tcs-admin-panel.vercel.app/:path*"
    },
    {
      "source": "/.netlify/functions/:path*",
      "destination": "/api/:path*"
    }
  ]
}
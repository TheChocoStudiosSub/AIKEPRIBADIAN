# Environment variables for the Vercel deployment.
# Configure these values in Vercel Project Settings > Environment Variables.
# Never commit real API keys or secret values.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Supabase knowledge API. Configure server-side only in Vercel.
TCS_KNOWLEDGE_SUPABASE_URL=
TCS_KNOWLEDGE_PUBLISHABLE_KEY=

# Server-only key used by Owner authentication and internal knowledge RPCs.
# Never expose this variable to browser code or commit a real value.
TCS_OWNER_AUTH_SERVER_KEY=

# Environment variables for the Vercel deployment.
# Configure these values in Vercel Project Settings > Environment Variables.
# Never commit real API keys or secret values.

# Groq inference. Server-side only.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional: separate key for the non-browser client=app route.
GROQ_API_KEY_APP=

# Choco AI Knowledge Hub and Owner authentication project.
# These three values must belong to the Choco AI Supabase project.
TCS_KNOWLEDGE_SUPABASE_URL=
TCS_KNOWLEDGE_PUBLISHABLE_KEY=
TCS_OWNER_AUTH_SERVER_KEY=

# TCS Backend project used only by the license gateway /api/license.
# Do not point these at the Choco AI Knowledge Hub project.
TCS_SUPABASE_URL=
TCS_SUPABASE_PUBLISHABLE_KEY=

# Legacy payment variables retained for existing server-side integrations.
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
# false = Sandbox; true = Production
MIDTRANS_IS_PRODUCTION=false
